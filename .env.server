LOSEME_EMBEDDING_MODEL=bge-m3
LOSEME_CHUNKER=simple
LOSEME_VECTOR_STORAGE=qdrant-hybrid
LOSEME_USE_CUDA=true
LOSEME_HOST_ROOT=/home/ben
LOSEME_API_KEY=e7335fb5a010080933fa12c4145c84efad99b7517eb97e3955e6a7eb862a0d02

# LLM Server Configuration
# Can point to a separate machine with GPU (e.g., http://192.168.1.100:11434)
# Supports both LOSEME_LLM_URL (recommended) and OLLAMA_URL (backward compatible)
LOSEME_LLM_URL=http://host.docker.internal:11434
LOSEME_LLM_MODEL=llama3
LOSEME_LLM_TIMEOUT=120

# Backward compatible (if LOSEME_LLM_URL not set, falls back to OLLAMA_URL)
OLLAMA_URL=http://host.docker.internal:11434
